# Docker-friendly MiniCA config template.
#
# Every value is a {{ENV:VAR:default}} token: it resolves to the environment
# variable when set, otherwise to the default after the second colon. The
# name/default are trimmed, names must match [A-Za-z_][A-Za-z0-9_]*, defaults
# may contain colons, and percent escapes are decoded on a best-effort basis.
# Only strict %HH hex escapes are decoded; '+' stays '+'. The defaults
# reproduce config.yaml.example, so running with no environment variables
# behaves exactly like the stock config. Tokens are resolved after YAML parsing,
# inside string values only: a resolved value is always taken literally (it
# cannot inject YAML structure), and numeric/boolean fields accept it as text.
# Tokens inside comments are ignored.
#
#   podman run -e MINICA_PORT=8443 -e MINICA_ADMIN_PASSWORD='$2b$12$...' ...
#   minica --start -c config.yaml.docker
#
# SECURITY: with no environment overrides the server listens on all interfaces
# (0.0.0.0) and the bootstrap admin is admin / adminpass, a publicly known
# password (the server logs a warning when it is in use). That is only
# acceptable for throwaway test containers. In any other deployment set
# MINICA_ADMIN_PASSWORD, preferably to a bcrypt hash from
# `minica --gen-password`, e.g.
#   podman run -e MINICA_ADMIN_PASSWORD="$(cat admin-password.bcrypt)" ...
# (or pass it from a secret / env file: --env-file, Kubernetes Secret, ...).

server:
  host: {{ENV:MINICA_HOST:0.0.0.0}}
  port: {{ENV:MINICA_PORT:9988}}
  base_path: {{ENV:MINICA_BASE_PATH:/minica}}
  # Mark cookies Secure. Only enable when every browser reaches MiniCA over HTTPS.
  secure_cookies: {{ENV:MINICA_SECURE_COOKIES:false}}

public_base_url: {{ENV:MINICA_PUBLIC_BASE_URL:http://127.0.0.1:9988/minica}}

crl:
  enabled: {{ENV:MINICA_CRL_ENABLED:true}}
  next_update_days: {{ENV:MINICA_CRL_NEXT_UPDATE_DAYS:30}}

runtime:
  folder: {{ENV:MINICA_RUNTIME_FOLDER:./runtime}}
  db_folder: {{ENV:MINICA_DB_FOLDER:null}}

logging:
  file: {{ENV:MINICA_LOG_FILE:./logs/minica.log}}
  rotate_size_bytes: {{ENV:MINICA_LOG_ROTATE_SIZE_BYTES:10485760}}
  max_backups: {{ENV:MINICA_LOG_MAX_BACKUPS:10}}
  compress: {{ENV:MINICA_LOG_COMPRESS:true}}

openssl:
  path: {{ENV:MINICA_OPENSSL_PATH:/usr/bin/openssl}}
  timeout_seconds: {{ENV:MINICA_OPENSSL_TIMEOUT_SECONDS:15}}
  working_root: {{ENV:MINICA_OPENSSL_WORKING_ROOT:./runtime/openssl-work}}
  keep_failed_workdirs: {{ENV:MINICA_OPENSSL_KEEP_FAILED_WORKDIRS:false}}
  reap_after_hours: {{ENV:MINICA_OPENSSL_REAP_AFTER_HOURS:24}}

# Both auth sections coexist. When both are enabled, header identity wins when
# present; Basic auth remains available for requests without identity headers.
auth:
  users:
    enabled: {{ENV:MINICA_BASIC_AUTH_ENABLE:true}}
    list:
      - username: {{ENV:MINICA_ADMIN_USER:admin}}
        # Default "adminpass" is for tests only: override MINICA_ADMIN_PASSWORD.
        password: {{ENV:MINICA_ADMIN_PASSWORD:adminpass}}
        role: {{ENV:MINICA_ADMIN_ROLE:admin}}

  # Reverse-proxy header auth. Defaults to disabled: enabling it makes MiniCA
  # trust identity headers, so only turn it on behind an authenticating proxy
  # and pin the proxy with MINICA_TRUSTED_REMOTE_1..10. With header auth
  # enabled, an empty trusted list is rejected at startup.
  headers:
    enabled: {{ENV:MINICA_HEADER_AUTH_ENABLE:false}}
    username: {{ENV:MINICA_HEADER_USERNAME:Remote-User}}
    group: {{ENV:MINICA_HEADER_GROUP:Remote-Groups}}
    admin_group: {{ENV:MINICA_HEADER_ADMIN_GROUP:admin}}
    viewer_group: {{ENV:MINICA_HEADER_VIEWER_GROUP:user}}
    # Up to 10 trusted peers (IP or CIDR), one env var per slot. '-' means the
    # slot is not used. When header auth is enabled and no slot is set (empty
    # trusted list), the server refuses to start unless
    # MINICA_HEADER_TRUST_ALL_REMOTES=true (trusts identity headers from ANY
    # peer; only safe when the port is reachable solely through the proxy).
    #   podman run -e MINICA_TRUSTED_REMOTE_1=10.0.0.7 -e MINICA_TRUSTED_REMOTE_2=172.16.0.0/12 ...
    trust_all_remotes: {{ENV:MINICA_HEADER_TRUST_ALL_REMOTES:false}}
    trusted_remotes:
      - '{{ENV:MINICA_TRUSTED_REMOTE_1:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_2:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_3:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_4:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_5:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_6:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_7:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_8:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_9:-}}'
      - '{{ENV:MINICA_TRUSTED_REMOTE_10:-}}'

# Pre-filled values of the "New CA" / "New Certificate" forms. Unset variables
# keep the built-in defaults; the certificate form inherits anything left
# unset here from the issuing CA's subject. Named presets (templates.ca /
# templates.certificate) are lists and cannot be expressed as variables: mount
# your own config file over /opt/minica/config.yaml to use them (see
# config.yaml.example).
templates:
  defaults:
    country_code: '{{ENV:MINICA_DEFAULT_COUNTRY_CODE:}}'
    state: '{{ENV:MINICA_DEFAULT_STATE:}}'
    city: '{{ENV:MINICA_DEFAULT_CITY:}}'
    organization: '{{ENV:MINICA_DEFAULT_ORGANIZATION:}}'
    organization_unit: '{{ENV:MINICA_DEFAULT_ORGANIZATION_UNIT:}}'
    valid_days: '{{ENV:MINICA_DEFAULT_VALID_DAYS:}}'
    digest_algorithm: '{{ENV:MINICA_DEFAULT_DIGEST:}}'
    key_profile: '{{ENV:MINICA_DEFAULT_KEY_PROFILE:}}'
